def string_operations(s):
    reversed_string = s[::-1]
    every_second = s[::2]
    return reversed_string, every_second

print(string_operations("hello"))




def even_squares(lst):
    return [x**2 for x in lst if x % 2 == 0]

print(even_squares([1,2,3,4,5,6]))



def char_frequency(s):
    freq = {}
    for char in s:
        freq[char] = freq.get(char, 0) + 1
    return freq

print(char_frequency("hello"))




def odd_indices(lst):
    return [i for i, x in enumerate(lst) if x % 2 != 0]

print(odd_indices([1,2,3,4,5]))



def rotate_list(lst, k):
    return lst[-k:] + lst[:-k]

print(rotate_list([1,2,3,4,5], 2))



def lists_to_dict(keys, values):
    return dict(zip(keys, values))

print(lists_to_dict(['a','b','c'], [1,2,3]))




def manual_iteration(lst):
    it = iter(lst)
    while True:
        try:
            print(next(it))
        except StopIteration:
            break

manual_iteration([1,2,3,4])




def flatten(lst):
    return [item for sublist in lst for item in sublist]

print(flatten([[1,2],[3,4],[5]]))




def is_palindrome(s):
    return s == s[::-1]

print(is_palindrome("madam"))




def second_largest(lst):
    first = second = float('-inf')
    for num in lst:
        if num > first:
            second = first
            first = num
        elif num > second and num != first:
            second = num
    return second

print(second_largest([10,20,4,45,99]))





